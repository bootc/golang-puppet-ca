# Puppet agent (client) image for the openvox-ca integration test stack.
#
# Provides a minimal CentOS Stream 10 container with the OpenVox 8 agent,
# curl, and openssl.  The entrypoint keeps the container alive so the host-side
# test script can drive it with `$engine exec`.

FROM quay.io/centos/centos:stream10

RUN dnf -y install https://yum.voxpupuli.org/openvox8-release-el-10.noarch.rpm && \
    dnf -y install openvox-agent curl openssl && \
    dnf clean all

ENV PATH=/opt/puppetlabs/puppet/bin:${PATH}

# SECURITY: Run as non-root to limit blast radius of container escape.
# NIST 800-53: AC-6 (Least Privilege), CM-7 (Least Functionality)
#
# The puppet agent needs write access to its config, cache, log, and run
# directories at runtime (SSL bootstrap, catalog cache, reports, etc.).
# The uid/gid is pinned so `USER` below can be numeric: the host has no way to
# resolve a name out of the image's /etc/passwd.  1000 rather than a system uid
# -- the system range is already crowded here (openvox-agent's own `puppet` at
# 52, chrony at 998, systemd-oom at 999), so `useradd -r` lands on whatever
# happens to be free that day, and it matches the uid the openvox-ca images
# use.  groupadd/useradd fail the build if anything else has taken it.
RUN groupadd -g 1000 puppet-agent && \
    useradd -u 1000 -g puppet-agent -m -d /home/puppet-agent -s /sbin/nologin puppet-agent && \
    mkdir -p \
        /etc/puppetlabs/puppet/ssl \
        /opt/puppetlabs/puppet/cache \
        /opt/puppetlabs/puppet/public \
        /var/log/puppetlabs/puppet \
        /var/run/puppetlabs && \
    chown -R puppet-agent:puppet-agent \
        /etc/puppetlabs/puppet \
        /opt/puppetlabs/puppet/cache \
        /opt/puppetlabs/puppet/public \
        /var/log/puppetlabs/puppet \
        /var/run/puppetlabs
USER 1000:1000

ENTRYPOINT ["tail", "-f", "/dev/null"]
